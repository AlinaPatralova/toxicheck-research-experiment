# Public build flag only. Enable after applying the SQL migration and setting server keys.
VITE_RESEARCH_COLLECTION_ENABLED=false

# Server/export script only. NEVER add a VITE_ prefix to database keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: exact production origin, without a trailing slash.
# If empty, the API requires Origin to match its own URL.
RESEARCH_ALLOWED_ORIGIN=
